<Application
    x:Class="DiezPublishingStudio.UnoSpike.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Physical-review request: focused text controls must be unmistakable on white. -->
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#007FFF" />
      <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#007FFF" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
