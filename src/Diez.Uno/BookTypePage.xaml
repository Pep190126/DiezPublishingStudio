<Page
    x:Class="DiezPublishingStudio.UnoSpike.BookTypePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="White">
    <StackPanel Width="720" HorizontalAlignment="Left" Margin="40" Spacing="14">
      <TextBlock Text="Tipo libro" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Text="Titolo del libro" FontWeight="SemiBold" HorizontalAlignment="Left" />
      <TextBox x:Name="BookTitleBox"
               Width="560"
               HorizontalAlignment="Left"
               TextChanged="BookTitleBox_TextChanged"
               PlaceholderText="Titolo del libro" />
      <TextBlock Text="Il campo deve mostrare il caret, accettare selezione/cancellazione e digitazione normale." TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
        <Button Content="Home progetto" Click="Home_Click" Padding="20,10" />
        <Button Content="Vai a Coloring Book 1/4" Click="OpenColoring_Click" Padding="20,10" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Page>
